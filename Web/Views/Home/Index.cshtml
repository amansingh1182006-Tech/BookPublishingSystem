@{
    ViewData["Title"] = "BJainRx - Premier Homeopathy Digital Library & Platform";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.5/babel.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navyDark: '#0B1325',
                        navyDeep: '#111C35',
                        emeraldPrimary: '#00A884',
                        emeraldHover: '#008F70',
                        emeraldLight: '#E6F7F3',
                        goldAccent: '#D4AF37',
                        goldLight: '#FFFBF0',
                        creamBg: '#F8FAF9',
                        slateDark: '#1E293B',
                        publisherPurple: '#6366F1'
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #F8FAF9;
            color: #1E293B;
        }

        .no-select {
            user-select: none;
            -webkit-user-select: none;
        }

        .bjain-blue {
            background-color: #0d233a;
        }

        .bjain-red {
            background-color: #be1e2d;
        }

        .hero-pattern {
            background-color: #0B1325;
            background-image: radial-gradient(#00A884 0.75px, transparent 0.75px), radial-gradient(#00A884 0.75px, #0B1325 0.75px);
            background-size: 30px 30px;
            background-position: 0 0, 15px 15px;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #F1F5F9;
        }

        ::-webkit-scrollbar-thumb {
            background: #00A884;
            border-radius: 3px;
        }
    </style>
</head>
<body class="bg-creamBg text-slate-800 font-sans antialiased no-select">
    <div id="root"></div>

    <!-- Scripts with explicit reactivity handling -->
    <script type="text/babel" data-presets="react" src="/js/AddBookForm.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/EditBookForm.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/AddAuthorForm.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/EditAuthorForm.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/AddCategoryForm.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/EditCategoryForm.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/AddLanguageForm.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/EditLanguageForm.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/AddPlanForm.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/VendorMaster.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/PlanMaster.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/BundleMaster.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/UserPlansPage.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/SingleBookMaster.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/PlatformRevenueMaster.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/JournalMaster.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/EmbeddedReaderProfile.js?v=@DateTime.Now.Ticks"></script>
    <script type="text/babel" data-presets="react" src="/js/app.js?v=@DateTime.Now.Ticks"></script>
</body>
</html>