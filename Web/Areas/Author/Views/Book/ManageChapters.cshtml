@{
    ViewData["Title"] = "Author Studio - Manage Chapters";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.5/babel.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-950 text-slate-100 font-sans">
    <div id="manage-chapters-root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        function ManageChaptersApp() {
            const [books, setBooks] = useState([]);
            const [selectedBookId, setSelectedBookId] = useState('');
            const [title, setTitle] = useState('');
            const [sequenceNumber, setSequenceNumber] = useState(1);
            const [isFreePreview, setIsFreePreview] = useState(false);
            const [file, setFile] = useState(null);
            const [uploading, setUploading] = useState(false);

            useEffect(() => {
                fetchMyBooks();
            }, []);

            const fetchMyBooks = async () => {
                const res = await fetch('/api/author/book/my-books');
                if (res.ok) {
                    const data = await res.json();
                    setBooks(data);
                    if (data.length > 0) setSelectedBookId(data[0].id);
                }
            };

            const handleChapterUpload = async (e) => {
                e.preventDefault();
                if (!file || !selectedBookId) return alert("Please select a book and a valid PDF file.");

                setUploading(true);
                const formData = new FormData();
                formData.append('chapterFile', file);
                formData.append('title', title);
                formData.append('sequenceNumber', sequenceNumber);
                formData.append('isFreePreview', isFreePreview);

                try {
                    const res = await fetch(`/api/author/book/${selectedBookId}/upload-chapter`, {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok) {
                        alert("PDF Chapter uploaded securely!");
                        setTitle('');
                        setFile(null);
                        fetchMyBooks();
                    } else {
                        const err = await res.json();
                        alert(err.message || "Upload failed.");
                    }
                } catch (err) {
                    alert("Error uploading chapter.");
                } finally {
                    setUploading(false);
                }
            };

            return (
                <div className="max-w-5xl mx-auto p-6 space-y-6">
                    <div className="flex items-center justify-between bg-slate-900 p-4 rounded-lg border border-slate-800">
                        <h1 className="text-lg font-bold text-white"><i className="fa-solid fa-pen-nib text-red-500 me-2"></i> Author Chapter Studio</h1>
                        <a href="/Author/Profile/Index" className="text-xs text-slate-400 hover:text-white">Back to Profile</a>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                        {/* CHAPTER UPLOAD FORM */}
                        <form onSubmit={handleChapterUpload} className="md:col-span-1 bg-slate-900 p-5 rounded-lg border border-slate-800 space-y-4 text-xs">
                            <h3 className="font-bold text-sm text-slate-200 border-b border-slate-800 pb-2">Upload PDF Chapter</h3>

                            <div>
                                <label className="block mb-1 font-bold text-slate-400">Select Target Book</label>
                                <select value={selectedBookId} onChange={(e) => setSelectedBookId(e.target.value)} className="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white">
                                    {books.map(b => <option key={b.id} value={b.id}>{b.title}</option>)}
                                </select>
                            </div>

                            <div>
                                <label className="block mb-1 font-bold text-slate-400">Chapter Title</label>
                                <input type="text" required value={title} onChange={(e) => setTitle(e.target.value)} placeholder="e.g. Chapter 1: Basic Principles" className="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white outline-none" />
                            </div>

                            <div>
                                <label className="block mb-1 font-bold text-slate-400">Sequence Number</label>
                                <input type="number" value={sequenceNumber} onChange={(e) => setSequenceNumber(e.target.value)} className="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white outline-none" />
                            </div>

                            <div className="flex items-center gap-2">
                                <input type="checkbox" id="free" checked={isFreePreview} onChange={(e) => setIsFreePreview(e.target.checked)} />
                                <label htmlFor="free" className="text-slate-300">Is Free Preview Chapter?</label>
                            </div>

                            <div>
                                <label className="block mb-1 font-bold text-slate-400">PDF File</label>
                                <input type="file" accept="application/pdf" required onChange={(e) => setFile(e.target.files[0])} className="w-full text-slate-400 text-[11px]" />
                            </div>

                            <button type="submit" disabled={uploading} className="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 rounded transition shadow">
                                {uploading ? 'Encrypting & Saving...' : 'Save & Encrypt Chapter'}
                            </button>
                        </form>

                        {/* MY BOOKS LIST */}
                        <div className="md:col-span-2 bg-slate-900 p-5 rounded-lg border border-slate-800 space-y-4">
                            <h3 className="font-bold text-sm text-slate-200 border-b border-slate-800 pb-2">Your Published Publications</h3>
                            <div className="space-y-3">
                                {books.map(b => (
                                    <div key={b.id} className="bg-slate-950 border border-slate-800 p-4 rounded-lg flex items-center justify-between text-xs">
                                        <div>
                                            <h4 className="font-bold text-white text-sm">{b.title}</h4>
                                            <p className="text-slate-400 text-[11px]">Price: ₹{b.price} | Chapters: {b.chapterCount}</p>
                                        </div>
                                        <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${b.isPublished ? 'bg-emerald-950 text-emerald-400' : 'bg-amber-950 text-amber-400'}`}>
                                            {b.isPublished ? 'Published' : 'Draft'}
                                        </span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('manage-chapters-root'));
        root.render(<ManageChaptersApp />);
    </script>
</body>
</html>