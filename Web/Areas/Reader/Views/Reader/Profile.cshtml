@{
    ViewData["Title"] = "My Profile - B. Jain Publishers";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.5/babel.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        .no-select {
            user-select: none;
            -webkit-user-select: none;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col no-select">
    <div id="profile-app-root" class="flex-1 flex flex-col"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        function ReaderProfileApp() {
            const [profile, setProfile] = useState({
                custId: '',
                custName: '',
                mobileNo: '',
                emailId: '',
                address1: '',
                address2: '',
                country: 'India',
                state: '',
                postalCode: '',
                landmark: ''
            });

            const [isEditMode, setIsEditMode] = useState(false);
            const [isLoading, setIsLoading] = useState(true);
            const [isSaving, setIsSaving] = useState(false);
            const [message, setMessage] = useState({ text: '', type: '' });

            // MY LIBRARY STATE
            const [libraryBooks, setLibraryBooks] = useState([]);
            const [isLibraryLoading, setIsLibraryLoading] = useState(true);

            // ACTIVE PLANS & PURCHASED BUNDLES STATE
            const [membershipData, setMembershipData] = useState({ plans: [], bundles: [] });
            const [isMembershipLoading, setIsMembershipLoading] = useState(true);

            // HELPER TO FETCH MY LIBRARY WITH FALLBACK ROUTES
            const fetchUserLibrary = async () => {
                setIsLibraryLoading(true);
                try {
                    let res = await fetch('/Reader/api/my-library');
                    if (!res.ok) {
                        res = await fetch('/api/reader/my-library');
                    }
                    if (res.ok) {
                        const data = await res.json();
                        setLibraryBooks(Array.isArray(data) ? data : []);
                    }
                } catch (err) {
                    console.error("Library fetch error:", err);
                } finally {
                    setIsLibraryLoading(false);
                }
            };

            // HELPER TO FETCH ACTIVE PLANS & PURCHASED BUNDLES
            const fetchMembershipDetails = async () => {
                setIsMembershipLoading(true);
                try {
                    const res = await fetch('/api/plan/my-profile-membership');
                    if (res.ok) {
                        const data = await res.json();
                        setMembershipData({
                            plans: Array.isArray(data.plans) ? data.plans : [],
                            bundles: Array.isArray(data.bundles) ? data.bundles : []
                        });
                    }
                } catch (err) {
                    console.error("Membership fetch error:", err);
                } finally {
                    setIsMembershipLoading(false);
                }
            };

            useEffect(() => {
                // 1. Fetch Profile Status
                fetch('/Reader/profile-status')
                    .then(res => res.ok ? res.json() : null)
                    .then(data => {
                        if (data) {
                            if (data.profile) {
                                setProfile({
                                    custId: data.profile.custId || 'CUST-READER',
                                    custName: data.profile.custName || '',
                                    mobileNo: data.profile.mobileNo || '',
                                    emailId: data.profile.emailId || data.email || '',
                                    address1: data.profile.address1 || '',
                                    address2: data.profile.address2 || '',
                                    country: data.profile.country || 'India',
                                    state: data.profile.state || '',
                                    postalCode: data.profile.postalCode || '',
                                    landmark: data.profile.landmark || ''
                                });
                            } else {
                                setProfile(prev => ({
                                    ...prev,
                                    custName: data.fullName || '',
                                    emailId: data.email || ''
                                }));
                            }

                            if (!data.hasProfile) {
                                setIsEditMode(true);
                            }
                        }
                    })
                    .catch(err => setMessage({ text: 'Error loading profile: ' + err.message, type: 'error' }))
                    .finally(() => setIsLoading(false));

                // 2. Initial Library & Membership Load
                fetchUserLibrary();
                fetchMembershipDetails();

                // 3. Tab Focus Real-Time Sync
                const handleFocus = () => {
                    fetchUserLibrary();
                    fetchMembershipDetails();
                };
                window.addEventListener('focus', handleFocus);
                return () => window.removeEventListener('focus', handleFocus);
            }, []);

            const handleSubmitUpdate = async (e) => {
                e.preventDefault();
                setIsSaving(true);
                setMessage({ text: '', type: '' });

                try {
                    const res = await fetch('/Reader/upsert-profile', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(profile)
                    });

                    const data = await res.json();
                    if (res.ok) {
                        setMessage({ text: 'Profile details successfully saved!', type: 'success' });
                        setIsEditMode(false);
                    } else {
                        setMessage({ text: data.message || 'Profile save failed.', type: 'error' });
                    }
                } catch (err) {
                    setMessage({ text: 'Network connection error: ' + err.message, type: 'error' });
                } finally {
                    setIsSaving(false);
                }
            };

            const handleResumeBook = (bookItem) => {
                if (!bookItem) return;
                const targetBookId = bookItem.bookId || bookItem.BookId || bookItem.id || bookItem.Id || bookItem.itemNo;
                const targetPage = bookItem.lastReadPage || 1;

                window.location.href = `/?readBookId=${encodeURIComponent(targetBookId)}&page=${targetPage}`;
            };

            if (isLoading) {
                return (
                    <div className="flex-1 flex flex-col items-center justify-center text-slate-600 font-bold text-xs gap-3">
                        <i className="fa-solid fa-spinner fa-spin text-3xl text-[#be1e2d]"></i>
                        <span>Loading Profile...</span>
                    </div>
                );
            }

            return (
                <div className="flex-1 flex flex-col bg-gray-100">
                    {/* TOP HEADER */}
                    <header className="bg-[#0d233a] text-white sticky top-0 z-50 shadow-md">
                        <div className="w-full px-4 md:px-8 py-2.5 flex items-center justify-between">
                            <div className="flex items-center gap-3 cursor-pointer" onClick={() => window.location.href = '/'}>
                                <div className="bg-white p-1.5 rounded shadow flex items-center gap-2">
                                    <div className="w-8 h-8 rounded bg-[#be1e2d] flex items-center justify-center font-black text-white text-xl">BJ</div>
                                    <div className="text-left leading-none pr-1">
                                        <div className="text-[#0d233a] font-extrabold text-sm uppercase">B. Jain Group</div>
                                        <div className="text-[9px] text-[#be1e2d] font-bold uppercase tracking-widest">Publishers</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {/* SUB-HEADER NAVIGATION */}
                        <div className="bg-[#163554] text-xs px-4 md:px-8 py-2 flex items-center gap-6 border-t border-slate-700/50">
                            <button onClick={() => window.location.href = '/'} className="font-bold flex items-center gap-1.5 text-gray-200 hover:text-white transition cursor-pointer">
                                <i className="fa-solid fa-store"></i> Home
                            </button>
                            <button onClick={() => window.location.href = '/Reader/Profile'} className="font-bold flex items-center gap-1.5 text-amber-400 border-b-2 border-amber-400 pb-0.5 cursor-pointer">
                                <i className="fa-solid fa-user"></i> My Profile
                            </button>
                        </div>
                    </header>

                    {/* MAIN CONTENT AREA */}
                    <main className="flex-1 w-full max-w-5xl mx-auto p-4 md:p-8 my-4 space-y-6">

                        {/* ALERT MESSAGES */}
                        {message.text && (
                            <div className={`p-4 rounded-lg text-xs font-bold flex items-center justify-between shadow-sm ${
                                message.type === 'error' ? 'bg-red-50 text-red-600 border border-red-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                            }`}>
                                <div className="flex items-center gap-2">
                                    <i className={`fa-solid ${message.type === 'error' ? 'fa-circle-exclamation text-base' : 'fa-circle-check text-base'}`}></i>
                                    <span>{message.text}</span>
                                </div>
                                <button onClick={() => setMessage({ text: '', type: '' })} className="text-slate-400 hover:text-slate-700 font-bold">✕</button>
                            </div>
                        )}

                        {/* PROFILE CONTAINER */}
                        <div className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">

                            {/* USER BANNER CARD */}
                            <div className="bg-gradient-to-r from-[#0d233a] to-[#163554] p-6 md:p-8 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                                <div className="flex items-center gap-4">
                                    <div className="w-20 h-20 rounded-full bg-[#be1e2d] border-4 border-white/20 flex items-center justify-center font-black text-3xl text-white shadow-xl">
                                        {profile.custName ? profile.custName[0].toUpperCase() : 'U'}
                                    </div>
                                    <div className="space-y-1">
                                        <div className="flex flex-wrap items-center gap-2">
                                            <h1 className="text-2xl font-black">{profile.custName || 'Reader Account'}</h1>
                                            <span className="bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">Reader Account</span>
                                        </div>
                                        <p className="text-xs text-gray-300 flex items-center gap-2">
                                            <i className="fa-solid fa-envelope text-red-400"></i> {profile.emailId || 'Registered Email'}
                                        </p>
                                        <p className="text-[11px] text-gray-400 font-mono">Customer ID: {profile.custId || 'Pending Setup'}</p>
                                    </div>
                                </div>

                                {/* EDIT / VIEW TOGGLE BUTTON */}
                                <div className="flex items-center gap-3">
                                    {!isEditMode ? (
                                        <button
                                            onClick={() => setIsEditMode(true)}
                                            className="bg-[#be1e2d] hover:bg-red-700 text-white font-bold px-5 py-2.5 rounded-lg text-xs shadow-md transition cursor-pointer flex items-center gap-2">
                                            <i className="fa-solid fa-pen-to-square"></i> Edit Profile
                                        </button>
                                    ) : (
                                        profile.mobileNo && profile.address1 ? (
                                            <button
                                                onClick={() => setIsEditMode(false)}
                                                className="bg-slate-700 hover:bg-slate-600 text-white font-bold px-5 py-2.5 rounded-lg text-xs transition cursor-pointer flex items-center gap-2">
                                                <i className="fa-solid fa-eye"></i> View Profile
                                            </button>
                                        ) : null
                                    )}
                                </div>
                            </div>

                            {/* BODY SECTION: DETAILS CARD OR EDIT FORM */}
                            <div className="p-6 md:p-8">
                                {!isEditMode ? (
                                    /* READ-ONLY DISPLAY MODE */
                                    <div className="space-y-8">
                                        <div>
                                            <h3 className="text-xs font-black uppercase text-slate-400 tracking-wider mb-4 flex items-center gap-2 border-b pb-2">
                                                <i className="fa-solid fa-user-gear text-[#be1e2d]"></i> Personal Details
                                            </h3>
                                            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-xs">
                                                <div className="bg-slate-50 p-4 rounded-xl border border-slate-100">
                                                    <span className="text-slate-400 font-bold block mb-1">Full Name</span>
                                                    <span className="font-extrabold text-slate-800 text-sm">{profile.custName || 'N/A'}</span>
                                                </div>
                                                <div className="bg-slate-50 p-4 rounded-xl border border-slate-100">
                                                    <span className="text-slate-400 font-bold block mb-1">Mobile Number</span>
                                                    <span className="font-extrabold text-slate-800 text-sm flex items-center gap-2">
                                                        <i className="fa-solid fa-phone text-emerald-600"></i> {profile.mobileNo || 'N/A'}
                                                    </span>
                                                </div>
                                                <div className="bg-slate-50 p-4 rounded-xl border border-slate-100">
                                                    <span className="text-slate-400 font-bold block mb-1">Email Address</span>
                                                    <span className="font-extrabold text-slate-800 text-sm">{profile.emailId || 'N/A'}</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div>
                                            <h3 className="text-xs font-black uppercase text-slate-400 tracking-wider mb-4 flex items-center gap-2 border-b pb-2">
                                                <i className="fa-solid fa-location-dot text-[#be1e2d]"></i> Address Information
                                            </h3>
                                            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 text-xs">
                                                <div className="bg-slate-50 p-4 rounded-xl border border-slate-100 md:col-span-2">
                                                    <span className="text-slate-400 font-bold block mb-1">Address Details</span>
                                                    <span className="font-bold text-slate-800 block text-sm">{profile.address1}</span>
                                                    {profile.address2 && <span className="text-slate-600 block mt-0.5">{profile.address2}</span>}
                                                    {profile.landmark && <span className="text-slate-500 text-[11px] block mt-1"><i className="fa-solid fa-map-pin me-1 text-red-500"></i>Landmark: {profile.landmark}</span>}
                                                </div>
                                                <div className="bg-slate-50 p-4 rounded-xl border border-slate-100">
                                                    <span className="text-slate-400 font-bold block mb-1">State & Country</span>
                                                    <span className="font-extrabold text-slate-800 text-sm">{profile.state}, {profile.country}</span>
                                                </div>
                                                <div className="bg-slate-50 p-4 rounded-xl border border-slate-100">
                                                    <span className="text-slate-400 font-bold block mb-1">Postal / Pincode</span>
                                                    <span className="font-mono font-extrabold text-indigo-700 text-sm">{profile.postalCode || 'N/A'}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ) : (
                                    /* EDIT / CREATE FORM MODE */
                                    <form onSubmit={handleSubmitUpdate} className="space-y-6 text-xs">
                                        <div className="flex items-center justify-between border-b pb-3">
                                            <h3 className="text-base font-extrabold text-[#0d233a] flex items-center gap-2">
                                                <i className="fa-solid fa-pen-to-square text-[#be1e2d]"></i> {profile.mobileNo && profile.address1 ? 'Edit Customer Profile' : 'Complete Your Profile Setup'}
                                            </h3>
                                            <span className="text-[11px] text-slate-400 font-semibold">* Required fields</span>
                                        </div>

                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                            <div>
                                                <label className="font-bold text-slate-700 block mb-1">Full Name *</label>
                                                <input
                                                    type="text"
                                                    required
                                                    value={profile.custName}
                                                    onChange={e => setProfile({ ...profile, custName: e.target.value })}
                                                    placeholder="Enter Full Name"
                                                    className="w-full border border-gray-300 rounded-lg px-3.5 py-2.5 font-bold outline-none focus:border-[#0d233a]"
                                                />
                                            </div>
                                            <div>
                                                <label className="font-bold text-slate-700 block mb-1">Mobile Number *</label>
                                                <input
                                                    type="text"
                                                    required
                                                    value={profile.mobileNo}
                                                    onChange={e => setProfile({ ...profile, mobileNo: e.target.value })}
                                                    placeholder="Enter 10-digit Mobile No."
                                                    className="w-full border border-gray-300 rounded-lg px-3.5 py-2.5 font-bold outline-none focus:border-[#0d233a]"
                                                />
                                            </div>
                                        </div>

                                        <div className="space-y-4">
                                            <div>
                                                <label className="font-bold text-slate-700 block mb-1">Address Line 1 *</label>
                                                <input
                                                    type="text"
                                                    required
                                                    value={profile.address1}
                                                    onChange={e => setProfile({ ...profile, address1: e.target.value })}
                                                    placeholder="House / Flat No., Building, Street"
                                                    className="w-full border border-gray-300 rounded-lg px-3.5 py-2.5 outline-none focus:border-[#0d233a]"
                                                />
                                            </div>
                                            <div>
                                                <label className="font-bold text-slate-700 block mb-1">Address Line 2 (Optional)</label>
                                                <input
                                                    type="text"
                                                    value={profile.address2 || ''}
                                                    onChange={e => setProfile({ ...profile, address2: e.target.value })}
                                                    placeholder="Area, Locality, Sector"
                                                    className="w-full border border-gray-300 rounded-lg px-3.5 py-2.5 outline-none focus:border-[#0d233a]"
                                                />
                                            </div>
                                        </div>

                                        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                                            <div>
                                                <label className="font-bold text-slate-700 block mb-1">Country *</label>
                                                <input
                                                    type="text"
                                                    required
                                                    value={profile.country}
                                                    onChange={e => setProfile({ ...profile, country: e.target.value })}
                                                    className="w-full border border-gray-300 rounded-lg px-3 py-2 font-bold outline-none bg-gray-50"
                                                />
                                            </div>
                                            <div>
                                                <label className="font-bold text-slate-700 block mb-1">State *</label>
                                                <input
                                                    type="text"
                                                    required
                                                    value={profile.state}
                                                    onChange={e => setProfile({ ...profile, state: e.target.value })}
                                                    placeholder="State"
                                                    className="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-[#0d233a]"
                                                />
                                            </div>
                                            <div>
                                                <label className="font-bold text-slate-700 block mb-1">Postal Code *</label>
                                                <input
                                                    type="text"
                                                    required
                                                    value={profile.postalCode}
                                                    onChange={e => setProfile({ ...profile, postalCode: e.target.value })}
                                                    placeholder="Pincode"
                                                    className="w-full border border-gray-300 rounded-lg px-3 py-2 font-mono outline-none focus:border-[#0d233a]"
                                                />
                                            </div>
                                            <div>
                                                <label className="font-bold text-slate-700 block mb-1">Landmark (Optional)</label>
                                                <input
                                                    type="text"
                                                    value={profile.landmark || ''}
                                                    onChange={e => setProfile({ ...profile, landmark: e.target.value })}
                                                    placeholder="Nearby Landmark"
                                                    className="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-[#0d233a]"
                                                />
                                            </div>
                                        </div>

                                        <div className="pt-4 border-t flex items-center justify-end gap-3">
                                            {profile.mobileNo && profile.address1 && (
                                                <button
                                                    type="button"
                                                    onClick={() => setIsEditMode(false)}
                                                    className="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-6 py-2.5 rounded-lg text-xs cursor-pointer">
                                                    Cancel
                                                </button>
                                            )}
                                            <button
                                                type="submit"
                                                disabled={isSaving}
                                                className="bg-[#be1e2d] hover:bg-red-700 text-white font-bold px-8 py-2.5 rounded-lg text-xs shadow-md transition cursor-pointer flex items-center gap-2">
                                                <i className="fa-solid fa-floppy-disk"></i>
                                                {isSaving ? 'Saving Profile...' : 'Save Profile Details'}
                                            </button>
                                        </div>
                                    </form>
                                )}
                            </div>
                        </div>

                        {/* ACTIVE SUBSCRIPTION PLANS & INCLUDED BOOKS SECTION */}
                        {!isEditMode && (
                            <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
                                <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b pb-4 gap-3">
                                    <div>
                                        <h3 className="text-lg font-black text-[#0d233a] flex items-center gap-2.5">
                                            <i className="fa-solid fa-crown text-amber-500"></i>
                                            My Active Subscription Plans & Included Books
                                        </h3>
                                        <p className="text-xs text-slate-500 mt-0.5">
                                            Plan validity timeline (Kab se kab tak active rahega) aur plan ke andar included sabhi books
                                        </p>
                                    </div>
                                    <div className="flex items-center gap-2">
                                        <button
                                            onClick={fetchMembershipDetails}
                                            title="Refresh Plans"
                                            className="text-xs text-slate-500 hover:text-[#0d233a] p-2 rounded-full hover:bg-slate-100 transition cursor-pointer">
                                            <i className="fa-solid fa-rotate-right"></i>
                                        </button>
                                        <a href="/" className="text-xs bg-[#0d233a] hover:bg-[#be1e2d] text-white px-4 py-2 rounded-lg font-bold transition shadow-sm">
                                            + Browse / Upgrade Plans
                                        </a>
                                    </div>
                                </div>

                                {isMembershipLoading ? (
                                    <div className="text-center py-8 text-xs font-bold text-slate-500 flex items-center justify-center gap-2">
                                        <i className="fa-solid fa-spinner fa-spin text-xl text-amber-500"></i>
                                        <span>Loading Subscription Details...</span>
                                    </div>
                                ) : membershipData.plans.length === 0 ? (
                                    <div className="text-center py-8 bg-slate-50 rounded-xl border border-dashed border-slate-300 space-y-2">
                                        <p className="text-xs font-bold text-slate-700">Abhi tak koi Subscription Plan active nahi hai.</p>
                                        <a href="/" className="inline-block text-xs bg-[#be1e2d] hover:bg-red-700 text-white px-5 py-2 rounded-lg font-bold transition">
                                            Explore Plans & Books
                                        </a>
                                    </div>
                                ) : (
                                    <div className="space-y-6">
                                        {membershipData.plans.map((planItem, pIdx) => {
                                            const startStr = new Date(planItem.startDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
                                            const endStr = new Date(planItem.endDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });

                                            return (
                                                <div key={pIdx} className="border border-slate-200 rounded-2xl overflow-hidden bg-slate-50/60 shadow-sm">
                                                    {/* PLAN HEADER & VALIDITY TIMELINE */}
                                                    <div className="bg-gradient-to-r from-[#0d233a] to-[#1b3b5c] text-white p-4 md:p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
                                                        <div className="space-y-1">
                                                            <div className="flex flex-wrap items-center gap-2">
                                                                <span className="text-base md:text-lg font-black text-amber-400">
                                                                    <i className="fa-solid fa-gem me-1.5"></i>{planItem.planName}
                                                                </span>
                                                                <span className={`text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full ${
                                                                    planItem.isActive
                                                                        ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-400/40'
                                                                        : 'bg-red-500/20 text-red-300 border border-red-400/40'
                                                                }`}>
                                                                    {planItem.isActive ? `Active • ${planItem.remainingDays} Days Left` : 'Expired'}
                                                                </span>
                                                            </div>
                                                            <p className="text-[11px] text-slate-300 font-mono">
                                                                Order ID: {planItem.transactionId || 'N/A'} • Paid: ₹{planItem.amountPaid} ({planItem.billingPeriod})
                                                            </p>
                                                        </div>

                                                        {/* START DATE TO END DATE BOX */}
                                                        <div className="bg-slate-900/60 border border-slate-700 rounded-xl px-4 py-2.5 flex items-center gap-4 text-xs shrink-0">
                                                            <div>
                                                                <span className="text-[10px] text-slate-400 block uppercase font-bold">Active From</span>
                                                                <span className="font-extrabold text-emerald-400">{startStr}</span>
                                                            </div>
                                                            <i className="fa-solid fa-arrow-right text-slate-500"></i>
                                                            <div>
                                                                <span className="text-[10px] text-slate-400 block uppercase font-bold">Valid Till</span>
                                                                <span className="font-extrabold text-amber-300">{endStr}</span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    {/* BOOKS INCLUDED IN THIS PLAN */}
                                                    <div className="p-4 md:p-5 space-y-3">
                                                        <div className="flex items-center justify-between">
                                                            <span className="text-xs font-extrabold text-slate-700 uppercase tracking-wide">
                                                                <i className="fa-solid fa-book-open text-[#be1e2d] me-1.5"></i>
                                                                Books Included in "{planItem.planName}" ({planItem.books?.length || 0})
                                                            </span>
                                                        </div>

                                                        {(!planItem.books || planItem.books.length === 0) ? (
                                                            <p className="text-xs text-slate-500 italic">Is plan ke liye books list abhi empty hai.</p>
                                                        ) : (
                                                            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                                                                {planItem.books.map((bk, bIdx) => (
                                                                    <div key={bIdx} className="bg-white border border-slate-200 rounded-xl p-3 flex items-center justify-between gap-3 hover:shadow-md transition">
                                                                        <div className="flex items-center gap-3 min-w-0">
                                                                            <img
                                                                                src={bk.coverImage || '/images/default-cover.png'}
                                                                                alt={bk.itemName}
                                                                                className="w-11 h-14 object-cover rounded border bg-slate-100 shrink-0"
                                                                            />
                                                                            <div className="min-w-0">
                                                                                <span className="text-[9px] font-black uppercase px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-700 border border-indigo-200 inline-block mb-0.5">
                                                                                    Plan: {planItem.planName}
                                                                                </span>
                                                                                <h4 className="font-bold text-xs text-slate-900 truncate" title={bk.itemName}>
                                                                                    {bk.itemName}
                                                                                </h4>
                                                                                <p className="text-[10px] text-slate-500 truncate">
                                                                                    {bk.authorName} • {bk.pages || 0} Pages
                                                                                </p>
                                                                            </div>
                                                                        </div>

                                                                        <button
                                                                            onClick={() => window.location.href = `/?readBookId=${encodeURIComponent(bk.id)}&page=1`}
                                                                            className="bg-[#0d233a] hover:bg-[#be1e2d] text-white text-[11px] font-bold px-3 py-1.5 rounded-lg shrink-0 transition cursor-pointer">
                                                                            Read
                                                                        </button>
                                                                    </div>
                                                                ))}
                                                            </div>
                                                        )}
                                                    </div>
                                                </div>
                                            );
                                        })}
                                    </div>
                                )}
                            </div>
                        )}

                        {/* MY PURCHASED BUNDLES SECTION */}
                        {!isEditMode && membershipData.bundles.length > 0 && (
                            <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
                                <div className="border-b pb-4">
                                    <h3 className="text-lg font-black text-[#0d233a] flex items-center gap-2.5">
                                        <i className="fa-solid fa-layer-group text-indigo-600"></i>
                                        My Purchased Book Bundles ({membershipData.bundles.length})
                                    </h3>
                                    <p className="text-xs text-slate-500 mt-0.5">
                                        Aapke kharide gaye bundles aur unke andar maujood sabhi books
                                    </p>
                                </div>

                                <div className="space-y-5">
                                    {membershipData.bundles.map((bnd, idx) => {
                                        const purDate = new Date(bnd.purchasedDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
                                        return (
                                            <div key={idx} className="border border-indigo-200 rounded-2xl overflow-hidden bg-indigo-50/30">
                                                <div className="bg-indigo-950 text-white px-5 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                                    <div className="flex flex-wrap items-center gap-2">
                                                        <i className="fa-solid fa-box-open text-amber-400"></i>
                                                        <span className="font-black text-sm">{bnd.bundleName}</span>
                                                        <span className="text-[10px] bg-indigo-500/30 border border-indigo-400/40 px-2 py-0.5 rounded-full font-bold">
                                                            {bnd.books?.length || 0} Books Included
                                                        </span>
                                                    </div>
                                                    <span className="text-[11px] text-indigo-200 font-mono">
                                                        Purchased: {purDate} • Paid: ₹{bnd.amountPaid}
                                                    </span>
                                                </div>

                                                <div className="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                                                    {(bnd.books || []).map((bk, bIdx) => (
                                                        <div key={bIdx} className="bg-white border border-slate-200 rounded-xl p-3 flex items-center justify-between gap-3 hover:shadow-md transition">
                                                            <div className="flex items-center gap-3 min-w-0">
                                                                <img
                                                                    src={bk.coverImage || '/images/default-cover.png'}
                                                                    alt={bk.itemName}
                                                                    className="w-11 h-14 object-cover rounded border bg-slate-100 shrink-0"
                                                                />
                                                                <div className="min-w-0">
                                                                    <span className="text-[9px] font-black uppercase px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-300 inline-block mb-0.5">
                                                                        Bundle: {bnd.bundleName}
                                                                    </span>
                                                                    <h4 className="font-bold text-xs text-slate-900 truncate" title={bk.itemName}>
                                                                        {bk.itemName}
                                                                    </h4>
                                                                    <p className="text-[10px] text-slate-500 truncate">{bk.authorName}</p>
                                                                </div>
                                                            </div>
                                                            <button
                                                                onClick={() => window.location.href = `/?readBookId=${encodeURIComponent(bk.id)}&page=1`}
                                                                className="bg-indigo-700 hover:bg-[#be1e2d] text-white text-[11px] font-bold px-3 py-1.5 rounded-lg shrink-0 transition cursor-pointer">
                                                                Read
                                                            </button>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        )}

                        {/* POCKET FM STYLE MY LIBRARY & CONTINUE READING SECTION */}
                        {!isEditMode && (
                            <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-5">
                                <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b pb-4 gap-2">
                                    <div>
                                        <h3 className="text-lg font-black text-[#0d233a] flex items-center gap-2.5">
                                            <i className="fa-solid fa-book-bookmark text-[#be1e2d]"></i>
                                            My Library & Continue Reading
                                        </h3>
                                        <p className="text-xs text-slate-500 mt-0.5">Resume reading your eBooks right from where you left</p>
                                    </div>
                                    <div className="flex items-center gap-2">
                                        <button
                                            onClick={fetchUserLibrary}
                                            title="Refresh Shelf"
                                            className="text-xs text-slate-500 hover:text-[#0d233a] p-1.5 rounded-full hover:bg-slate-100 transition">
                                            <i className="fa-solid fa-rotate-right"></i>
                                        </button>
                                        <span className="text-xs bg-red-50 text-[#be1e2d] border border-red-200 px-3 py-1 rounded-full font-bold">
                                            {libraryBooks.length} Books in Shelf
                                        </span>
                                    </div>
                                </div>

                                {isLibraryLoading ? (
                                    <div className="text-center py-8 text-xs font-bold text-slate-500 flex items-center justify-center gap-2">
                                        <i className="fa-solid fa-spinner fa-spin text-xl text-[#be1e2d]"></i>
                                        <span>Loading bookshelf...</span>
                                    </div>
                                ) : libraryBooks.length === 0 ? (
                                    <div className="text-center py-10 bg-slate-50 rounded-xl border border-dashed border-slate-300 space-y-3">
                                        <div className="w-12 h-12 rounded-full bg-slate-200 text-slate-400 flex items-center justify-center mx-auto text-xl">
                                            <i className="fa-solid fa-book-open"></i>
                                        </div>
                                        <p className="text-xs font-bold text-slate-700">Aapne abhi tak koi book padhna shuru nahi kiya hai.</p>
                                        <a href="/" className="inline-block text-xs bg-[#0d233a] hover:bg-[#be1e2d] text-white px-5 py-2.5 rounded-lg font-bold transition shadow-sm">
                                            Explore Store Catalogue
                                        </a>
                                    </div>
                                ) : (
                                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                                        {libraryBooks.map((item, idx) => {
                                            const totalPg = item.totalPages || 1;
                                            const lastPg = item.lastReadPage || 1;
                                            const progressPct = Math.min(Math.round((lastPg / totalPg) * 100), 100);

                                            return (
                                                <div key={idx} className="bg-slate-50 border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between hover:shadow-lg transition-all duration-200 group relative overflow-hidden">
                                                    <div className="flex gap-3">
                                                        <div className="w-16 h-22 bg-slate-200 rounded border overflow-hidden shrink-0 shadow-sm">
                                                            <img
                                                                src={item.coverImage || '/images/default-cover.png'}
                                                                alt={item.itemName}
                                                                className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                                            />
                                                        </div>

                                                        <div className="flex-1 min-w-0 space-y-1">
                                                            <span className="text-[9px] font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 px-2 py-0.5 rounded inline-block">
                                                                {item.categoryCode || 'HOMEO'}
                                                            </span>

                                                            <h4 className="font-bold text-xs text-slate-900 truncate group-hover:text-[#be1e2d] transition" title={item.itemName}>
                                                                {item.itemName}
                                                            </h4>

                                                            <p className="text-[11px] text-slate-500 font-medium truncate">
                                                                by {item.authorName}
                                                            </p>

                                                            <div className="text-[10px] text-slate-600 font-bold pt-1">
                                                                Page <span className="text-[#be1e2d]">{lastPg}</span> of {totalPg}
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div className="space-y-2 mt-4 pt-3 border-t border-slate-200">
                                                        <div className="space-y-1">
                                                            <div className="flex justify-between text-[10px] font-bold text-slate-500">
                                                                <span>Progress</span>
                                                                <span className="text-emerald-600 font-extrabold">{progressPct}%</span>
                                                            </div>
                                                            <div className="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden">
                                                                <div
                                                                    className="bg-emerald-500 h-full transition-all duration-500 rounded-full"
                                                                    style={{ width: `${progressPct}%` }}
                                                                ></div>
                                                            </div>
                                                        </div>

                                                        <button
                                                            onClick={() => handleResumeBook(item)}
                                                            className="w-full bg-[#0d233a] hover:bg-[#be1e2d] text-white font-bold py-2 rounded-lg text-xs transition shadow flex items-center justify-center gap-2 cursor-pointer mt-2"
                                                        >
                                                            <i className="fa-solid fa-circle-play text-amber-400"></i>
                                                            <span>Resume Page {lastPg}</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            );
                                        })}
                                    </div>
                                )}
                            </div>
                        )}
                    </main>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('profile-app-root'));
        root.render(<ReaderProfileApp />);
    </script>
</body>
</html>